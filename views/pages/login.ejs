<section class="panel-mini">
  <h2>Enter your name to begin</h2>
  <p>Use your name so your progress, completion time, and result are recorded correctly.</p>

  <% if (loginError) { %>
    <p class="message error"><%= loginError %></p>
  <% } %>

  <form method="POST" action="/login" class="form-grid">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required autofocus />
    <button class="btn" type="submit">Continue</button>
  </form>
</section>
