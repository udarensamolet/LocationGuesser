<p><%= intro %></p>

<% const normalizedRules = typeof rules === "string" ? rules.replace(/\\r\\n/g, "\n").replace(/\\n/g, "\n").trim() : ""; %>
<% const rawRuleLines = normalizedRules ? normalizedRules.split("\n").map((line) => line.trim()).filter(Boolean) : []; %>
<% const hasRulesTitle = rawRuleLines.length > 0 && /^how to play:/i.test(rawRuleLines[0]); %>
<% const rulesTitle = hasRulesTitle ? rawRuleLines.shift() : "Rules"; %>
<% const ruleLines = rawRuleLines.map((line) => line.replace(/^\d+[)\.]\s*/, "")); %>

<% if (ruleLines.length > 0) { %>
  <section class="panel-mini rules-panel">
    <h2><%= rulesTitle %></h2>
    <ol class="rules-list">
      <% for (const line of ruleLines) { %>
        <li class="rules-list-item"><%= line %></li>
      <% } %>
    </ol>
  </section>
<% } %>

<p>
  Current player: <strong><%= currentUser.displayName %></strong>
</p>

<p>
  <%= hasCompleted ? "This account has already completed the mission." : "Click the button below to start or continue the mission." %>
</p>

<form method="POST" action="/game/start" class="game-start-form">
  <button class="btn" type="submit">
    <%= hasCompleted ? "View mission result" : hasStarted ? "Continue mission" : "Start mission" %>
  </button>
</form>
