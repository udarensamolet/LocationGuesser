<p><%= intro %></p>

<% const normalizedRules = typeof rules === "string" ? rules.replace(/\\r\\n/g, "\n").replace(/\\n/g, "\n").trim() : ""; %>
<% const ruleLines = normalizedRules ? normalizedRules.split("\n").map((line) => line.trim()).filter(Boolean) : []; %>

<% if (ruleLines.length > 0) { %>
  <section class="panel-mini">
    <h2>Rules</h2>
    <ul class="rules-list">
      <% for (const line of ruleLines) { %>
        <li class="rules-list-item"><%= line %></li>
      <% } %>
    </ul>
  </section>
<% } %>

<p>
  Current player: <strong><%= currentUser.displayName %></strong>
</p>

<p>Click the button below to start or continue the mission.</p>

<form method="POST" action="/game/start" class="game-start-form">
  <button class="btn" type="submit">
    <%= hasStarted ? "Continue mission" : "Start mission" %>
  </button>
</form>
