# Server settings
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# Temporary local authentication switch
DEV_AUTH_BYPASS=true
DEV_USER_ID=dev-user
DEV_USER_EMAIL=employee@company.local
DEV_USER_NAME=Developer

# Optional: only enable this when a trusted platform injects identity headers
TRUST_PROXY_IDENTITY_HEADERS=false

# Comma separated list of administrator emails (case-insensitive match)
ADMIN_EMAILS=admin@company.local
